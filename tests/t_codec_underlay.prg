/* Tests 1:1 de underlay.rs (30 #[test]) + [extra] */
#include "ocx.ch"
STATIC FUNCTION Nr( a, b ) ; RETURN Abs( a - b ) < 0.0000000001
PROCEDURE T_CodecUnderlay()
   LOCAL d, u, bb, w, e, c
   d := Udf_New( UTY_PDF ) ; Chk( d[ "underlay_type" ] == UTY_PDF .AND. Empty( d[ "file_path" ] ), "underlay: test_underlay_definition_creation" )
   d := Udf_Pdf( "drawings/floor_plan.pdf", "Page 1" ) ; Chk( d[ "underlay_type" ] == UTY_PDF .AND. d[ "file_path" ] == "drawings/floor_plan.pdf" .AND. d[ "page_name" ] == "Page 1", "underlay: test_pdf_definition" )
   d := Udf_Dwf( "drawings/assembly.dwf", "Sheet 1" ) ; Chk( d[ "underlay_type" ] == UTY_DWF .AND. d[ "file_path" ] == "drawings/assembly.dwf", "underlay: test_dwf_definition" )
   d := Udf_Dgn( "drawings/site.dgn", "Default" ) ; Chk( d[ "underlay_type" ] == UTY_DGN .AND. d[ "file_path" ] == "drawings/site.dgn", "underlay: test_dgn_definition" )
   Chk( Udf_EntityName( Udf_New( UTY_PDF ) ) == "PDFDEFINITION" .AND. Udf_EntityName( Udf_New( UTY_DWF ) ) == "DWFDEFINITION" .AND. Udf_EntityName( Udf_New( UTY_DGN ) ) == "DGNDEFINITION", "underlay: test_definition_entity_names" )
   u := Eul_New( UTY_PDF ) ; Chk( u[ "underlay_type" ] == UTY_PDF .AND. Vc3_Eq( u[ "insertion_point" ], Vc3_Zero() ) .AND. u[ "x_scale" ] == 1.0 .AND. u[ "y_scale" ] == 1.0 .AND. u[ "z_scale" ] == 1.0, "underlay: test_underlay_creation" )
   u := Eul_Pdf() ; Chk( u[ "underlay_type" ] == UTY_PDF .AND. Eul_EntityName( u ) == "PDFUNDERLAY", "underlay: test_pdf_underlay" )
   u := Eul_Dwf() ; Chk( u[ "underlay_type" ] == UTY_DWF .AND. Eul_EntityName( u ) == "DWFUNDERLAY", "underlay: test_dwf_underlay" )
   u := Eul_Dgn() ; Chk( u[ "underlay_type" ] == UTY_DGN .AND. Eul_EntityName( u ) == "DGNUNDERLAY", "underlay: test_dgn_underlay" )
   u := Eul_PdfAt( Vc3_New( 10.0, 20.0, 0.0 ) ) ; Chk( u[ "insertion_point" ][ 1 ] == 10.0 .AND. u[ "insertion_point" ][ 2 ] == 20.0, "underlay: test_at_point" )
   u := Eul_WithScale( UTY_PDF, Vc3_Zero(), 2.5 ) ; Chk( u[ "x_scale" ] == 2.5 .AND. u[ "y_scale" ] == 2.5 .AND. u[ "z_scale" ] == 2.5, "underlay: test_with_scale" )
   u := Eul_Pdf() ; Eul_SetScale( u, 3.0 ) ; Chk( u[ "x_scale" ] == 3.0 .AND. u[ "y_scale" ] == 3.0 .AND. u[ "z_scale" ] == 3.0, "underlay: test_set_scale" )
   u := Eul_Pdf() ; Eul_SetScaleXyz( u, 1.0, 2.0, 3.0 ) ; Chk( u[ "x_scale" ] == 1.0 .AND. u[ "y_scale" ] == 2.0 .AND. u[ "z_scale" ] == 3.0, "underlay: test_set_scale_xyz" )
   u := Eul_Pdf() ; Eul_SetScale( u, 2.0 ) ; c := Eul_UniformScale( u ) ; Eul_SetScaleXyz( u, 1.0, 2.0, 1.0 ) ; Chk( c == 2.0 .AND. Eul_UniformScale( u ) == NIL, "underlay: test_uniform_scale" )
   u := Eul_Pdf() ; Eul_SetRotationDegrees( u, 45.0 ) ; Chk( Nr( Eul_RotationDegrees( u ), 45.0 ), "underlay: test_rotation" )
   u := Eul_Pdf() ; Eul_SetRectangularClip( u, { 0.0, 0.0 }, { 100.0, 100.0 } ) ; Chk( Eul_ClipVertexCount( u ) == 4 .AND. Eul_IsClipping( u ), "underlay: test_rectangular_clip" )
   u := Eul_Pdf() ; Eul_SetPolygonClip( u, { { 0.0, 0.0 }, { 100.0, 0.0 }, { 100.0, 100.0 }, { 50.0, 150.0 }, { 0.0, 100.0 } } ) ; Chk( Eul_ClipVertexCount( u ) == 5 .AND. Eul_IsClipping( u ), "underlay: test_polygon_clip" )
   u := Eul_Pdf() ; Eul_SetRectangularClip( u, { 0.0, 0.0 }, { 100.0, 100.0 } ) ; c := Eul_IsClipping( u ) ; Eul_ClearClip( u ) ; Chk( c .AND. ! Eul_IsClipping( u ) .AND. Eul_ClipVertexCount( u ) == 0, "underlay: test_clear_clip" )
   u := Eul_Pdf() ; c := Eul_IsOn( u ) ; Eul_SetOn( u, .F. ) ; w := ! Eul_IsOn( u ) ; Eul_SetOn( u, .T. ) ; Chk( c .AND. w .AND. Eul_IsOn( u ), "underlay: test_visibility" )
   u := Eul_Pdf() ; c := ! Eul_IsMonochrome( u ) ; Eul_SetMonochrome( u, .T. ) ; Chk( c .AND. Eul_IsMonochrome( u ), "underlay: test_monochrome" )
   u := Eul_Pdf() ; Eul_SetContrast( u, 75 ) ; c := u[ "contrast" ] == 75 ; Eul_SetContrast( u, 150 ) ; w := u[ "contrast" ] == 100 ; Eul_SetFade( u, 50 ) ; e := u[ "fade" ] == 50 ; Eul_SetFade( u, 150 )
   Chk( c .AND. w .AND. e .AND. u[ "fade" ] == 100, "underlay: test_contrast_fade" )
   u := Eul_Pdf() ; Ent_Translate( u, Vc3_New( 10.0, 20.0, 30.0 ) ) ; Chk( u[ "insertion_point" ][ 1 ] == 10.0 .AND. u[ "insertion_point" ][ 2 ] == 20.0 .AND. u[ "insertion_point" ][ 3 ] == 30.0, "underlay: test_translate" )
   Chk( Ent_EntityType( Eul_Pdf() ) == "PDFUNDERLAY" .AND. Ent_EntityType( Eul_Dwf() ) == "DWFUNDERLAY" .AND. Ent_EntityType( Eul_Dgn() ) == "DGNUNDERLAY", "underlay: test_entity_type" )
   u := Eul_Pdf() ; u[ "insertion_point" ] := Vc3_New( 10.0, 10.0, 0.0 ) ; u[ "x_scale" ] := 2.0 ; u[ "y_scale" ] := 2.0 ; u[ "rotation" ] := 0.0 ; Eul_SetRectangularClip( u, { 0.0, 0.0 }, { 5.0, 5.0 } ) ; w := Eul_WorldClipBoundary( u )
   Chk( Len( w ) == 4 .AND. Nr( w[ 1 ][ 1 ], 10.0 ) .AND. Nr( w[ 1 ][ 2 ], 10.0 ), "underlay: test_world_clip_boundary" )
   Chk( Uty_EntityName( UTY_PDF ) == "PDFUNDERLAY" .AND. Uty_EntityName( UTY_DWF ) == "DWFUNDERLAY" .AND. Uty_EntityName( UTY_DGN ) == "DGNUNDERLAY", "underlay: test_underlay_type_names" )
   u := Eul_Pdf() ; u[ "insertion_point" ] := Vc3_New( 10.0, 10.0, 0.0 ) ; Eul_SetRectangularClip( u, { 0.0, 0.0 }, { 100.0, 50.0 } ) ; bb := Ent_BoundingBox( u )
   Chk( Nr( bb[ 1 ][ 1 ], 10.0 ) .AND. Nr( bb[ 1 ][ 2 ], 10.0 ) .AND. Nr( bb[ 2 ][ 1 ], 110.0 ) .AND. Nr( bb[ 2 ][ 2 ], 60.0 ), "underlay: test_bounding_box_with_clip" )
   u := Eul_Pdf() ; Chk( hb_bitAnd( u[ "flags" ], UDF_ON ) != 0 .AND. hb_bitAnd( u[ "flags" ], UDF_CLIPPING ) == 0 .AND. hb_bitAnd( u[ "flags" ], UDF_MONOCHROME ) == 0, "underlay: test_flags" )
   u := Eul_New( UTY_PDF ) ; Chk( u[ "underlay_type" ] == UTY_PDF, "underlay: test_default" )
   /* [extra] */
   u := Eul_Pdf() ; u[ "insertion_point" ] := Vc3_New( 3.0, 4.0, 5.0 ) ; Ent_ApplyTransform( u, Tf_FromScale( 2.0 ) )
   Chk( Vc3_Eq( u[ "insertion_point" ], Vc3_New( 6.0, 8.0, 10.0 ) ) .AND. Nr( u[ "x_scale" ], 2.0 ) .AND. Nr( u[ "z_scale" ], 2.0 ), "underlay: [extra] transform escala insercion y factores" )
   u := Eul_Pdf() ; Chk( Vc3_Eq( Ent_BoundingBox( u )[ 2 ], Vc3_Zero() ) .AND. Eul_DisplayFlags( u ) == UDF_ON, "underlay: [extra] bbox sin clip y display_flags" )
   u[ "clip_inverted" ] := .T. ; Chk( Eul_DisplayFlags( u ) == hb_bitOr( UDF_ON, UDF_CLIP_INSIDE ), "underlay: [extra] display_flags con clip invertido" )
   Eul_SetPolygonClip( u, { { 0.0, 0.0 }, { 1.0, 0.0 } } ) ; Chk( Eul_ClipVertexCount( u ) == 0, "underlay: [extra] polygon_clip con menos de 3 vertices se ignora" )
   d := Udf_Pdf( "a/b.c/plano", "" ) ; Chk( Udf_FileExtension( d ) == NIL .AND. Udf_FileExtension( Udf_Pdf( "x/plano.PDF", "" ) ) == "PDF" .AND. ! Udf_FileExists( d ) .AND. Udf_SubclassMarker( Udf_Dgn( "", "" ) ) == "AcDbDgnDefinition", "underlay: [extra] file_extension y marcadores" )
RETURN
