/* Port de tests de text_writer.rs (7) y binary_writer.rs (5); stream_writer.rs no tiene tests. Extras marcados. */
#include "ocx.ch"
STATIC FUNCTION CRLFX() ; RETURN Chr( 13 ) + Chr( 10 )
STATIC FUNCTION Sent() ; RETURN "AutoCAD Binary DXF" + Chr( 13 ) + Chr( 10 ) + Chr( 26 ) + Chr( 0 )
PROCEDURE T_CodecWriter()
   LOCAL w, o, n, c
   // --- text_writer ---
   w := TxW_New() ; Sw_WriteString( w, 0, "LINE" )
   Chk( Sw_Output( w ) == "  0" + CRLFX() + "LINE" + CRLFX(), "text_writer: test_write_string" )
   w := TxW_New() ; Sw_WriteI16( w, 5, 100 ) ; Sw_WriteI16( w, 62, 7 ) ; Sw_WriteI16( w, 100, 1 ) ; o := Sw_Output( w )
   Chk( Left( o, 5 ) == "  5" + CRLFX() .AND. ( " 62" + CRLFX() ) $ o .AND. ( "100" + CRLFX() ) $ o, "text_writer: test_write_code_formatting" )
   w := TxW_New() ; Sw_WritePoint3d( w, 10, Vc3_New( 1.0, 2.0, 3.0 ) ) ; o := Sw_Output( w )
   Chk( ( " 10" + CRLFX() ) $ o .AND. ( "1.0" + CRLFX() ) $ o .AND. ( " 20" + CRLFX() ) $ o .AND. ( "2.0" + CRLFX() ) $ o .AND. ( " 30" + CRLFX() ) $ o .AND. ( "3.0" + CRLFX() ) $ o, "text_writer: test_write_point3d" )
   w := TxW_New() ; Sw_WriteHandle( w, 5, Hd_New( 255 ) )
   Chk( ( "FF" + CRLFX() ) $ Sw_Output( w ), "text_writer: test_write_handle" )
   w := TxW_New() ; Sw_WriteDouble( w, 10, 943.920153 )
   Chk( Sw_Output( w ) == " 10" + CRLFX() + "943.920153" + CRLFX(), "text_writer: test_write_double_compact" )
   w := TxW_New() ; Sw_WriteDouble( w, 40, 15.0 )
   Chk( Sw_Output( w ) == " 40" + CRLFX() + "15.0" + CRLFX(), "text_writer: test_write_double_integer_keeps_point" )
   // --- binary_writer ---
   w := BnW_New()
   Chk( Left( Sw_Output( w ), Len( Sent() ) ) == Sent(), "binary_writer: test_binary_sentinel" )
   n := Len( Sent() ) ; w := BnW_New() ; Sw_WriteString( w, 0, "LINE" ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1, 2 ) == Chr( 0 ) + Chr( 0 ) .AND. SubStr( o, n + 3, 4 ) == "LINE" .AND. SubStr( o, n + 7, 1 ) == Chr( 0 ), "binary_writer: test_write_string" )
   w := BnW_New() ; Sw_WriteDouble( w, 10, 1.5 ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1, 2 ) == Chr( 10 ) + Chr( 0 ) .AND. SubStr( o, n + 3, 8 ) == OCX_D2BIN( 1.5 ), "binary_writer: test_write_double" )
   w := BnW_New() ; Sw_WriteI16( w, 62, 7 ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1, 2 ) == Chr( 62 ) + Chr( 0 ) .AND. SubStr( o, n + 3, 2 ) == Chr( 7 ) + Chr( 0 ), "binary_writer: test_write_i16" )
   w := BnW_New() ; Sw_WriteString( w, 1, "Hello" + Chr( 13 ) + e"\n" + "World" + e"\n" + "Foo" + Chr( 13 ) + "Bar" ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 3 ) == "Hello\PWorld\PFoo\PBar" + Chr( 0 ), "binary_writer: test_write_string_newline_sanitization" )
   // --- [extra] ---
   w := TxW_New() ; Sw_WriteString( w, 1, "a^b^ c" ) ; Sw_WriteXRecordString( w, 1, "x^y" + Chr( 13 ) + e"\n" + "z" + Chr( 9 ) )
   Chk( Sw_Output( w ) == "  1" + CRLFX() + "a^ b^ c" + CRLFX() + "  1" + CRLFX() + "x^ y^M^Jz^I" + CRLFX(), "[extra] text_writer: escapes de ^ y xrecord" )
   w := TxW_New() ; Sw_WriteI32( w, 90, -5 ) ; Sw_WriteBool( w, 290, .T. ) ; Sw_WriteI64( w, 160, 123456789012 ) ; Sw_WriteHandle( w, 5, Hd_New( 0 ) ) ; Sw_WriteBinary( w, 310, Chr( 1 ) + Chr( 171 ) )
   Chk( Sw_Output( w ) == " 90" + CRLFX() + "    -5" + CRLFX() + "290" + CRLFX() + "     1" + CRLFX() + "160" + CRLFX() + "123456789012" + CRLFX() + "  5" + CRLFX() + "0" + CRLFX() + "310" + CRLFX() + "01AB" + CRLFX(), "[extra] text_writer: enteros, bool, i64, handle 0, binario" )
   w := TxW_New() ; Sw_WriteDouble( w, 1, OCX_INF() ) ; Sw_WriteDouble( w, 2, OCX_POW( 10.0, 15 ) ) ; Sw_WriteDouble( w, 3, OCX_POW( 2.0, -60 ) ) ; Sw_WriteDouble( w, 4, -0.5 ) ; Sw_WriteDouble( w, 5, 0.0 )
   Chk( Sw_Output( w ) == "  1" + CRLFX() + "0.0" + CRLFX() + "  2" + CRLFX() + "1.0000000000000000e15" + CRLFX() + "  3" + CRLFX() + "8.6736173798840355e-19" + CRLFX() + "  4" + CRLFX() + "-0.5" + CRLFX() + "  5" + CRLFX() + "0.0" + CRLFX(), "[extra] text_writer: no finito, exponentes {:.16e}" )
   w := TxW_New() ; Sw_WriteColor( w, 62, Cl_ByLayer() ) ; Sw_WriteColor( w, 62, Cl_Index( 3 ) ) ; Sw_WriteSectionStart( w, "HEADER" ) ; Sw_WriteSectionEnd( w ) ; Sw_WriteEof( w )
   Chk( ( " 62" + CRLFX() + "   256" + CRLFX() ) $ Sw_Output( w ) .AND. ( "     3" + CRLFX() ) $ Sw_Output( w ) .AND. ( "SECTION" + CRLFX() + "  2" + CRLFX() + "HEADER" + CRLFX() + "  0" + CRLFX() + "ENDSEC" + CRLFX() + "  0" + CRLFX() + "EOF" ) $ Sw_Output( w ), "[extra] text_writer: color y secciones" )
   w := BnW_New() ; Sw_WriteString( w, 70, " 5 " ) ; Sw_WriteString( w, 40, "2.5" ) ; Sw_WriteString( w, 310, "0aFF" ) ; Sw_WriteBool( w, 290, .T. ) ; Sw_WriteBool( w, 70, .T. ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1 ) == I2Bin( 70 ) + I2Bin( 5 ) + I2Bin( 40 ) + OCX_D2BIN( 2.5 ) + I2Bin( 310 ) + Chr( 2 ) + Chr( 10 ) + Chr( 255 ) + I2Bin( 290 ) + Chr( 1 ) + I2Bin( 70 ) + I2Bin( 1 ), "[extra] binary_writer: texto tipado, bool segun grupo" )
   w := BnW_New() ; c := Sw_WriteString( w, 70, "abc" )
   Chk( c != NIL .AND. "Invalid text value for binary DXF group 70" $ c .AND. Sw_WriteString( BnW_New(), 310, "ABC" ) != NIL .AND. Sw_WriteString( BnW_New(), 310, "ZZ" ) != NIL, "[extra] binary_writer: errores de texto tipado" )
   w := BnW_New() ; Sw_WriteHandle( w, 5, Hd_New( 0x1F ) ) ; Sw_WriteI64( w, 160, -2 ) ; Sw_WriteByte( w, 280, 9 ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1 ) == I2Bin( 5 ) + "1F" + Chr( 0 ) + I2Bin( 160 ) + OCX_I64BIN( -2 ) + I2Bin( 280 ) + I2Bin( 9 ), "[extra] binary_writer: handle, i64, byte" )
   w := BnW_New() ; Sw_WriteBinary( w, 310, Replicate( "a", 300 ) ) ; Sw_WriteBinary( w, 311, "" ) ; o := Sw_Output( w )
   Chk( SubStr( o, n + 1, 3 ) == I2Bin( 310 ) + Chr( 255 ) .AND. SubStr( o, n + 3 + 256, 3 ) == I2Bin( 310 ) + Chr( 45 ) .AND. Right( o, 3 ) == I2Bin( 311 ) + Chr( 0 ), "[extra] binary_writer: binario en trozos de 255" )
   // roundtrip lector/escritor
   w := BnW_New() ; Sw_WriteString( w, 0, "SECTION" ) ; Sw_WriteDouble( w, 10, 0.1 + 0.2 ) ; Sw_WriteI32( w, 90, -7 )
   c := BnR_New( Sw_Output( w ) ) ; BnR_ReadPair( c ) ; o := BnR_ReadPair( c )
   Chk( Dp_AsDouble( o ) == 0.1 + 0.2 .AND. Dp_AsInt( BnR_ReadPair( c ) ) == -7, "[extra] binario: roundtrip escritor->lector" )
   w := TxW_New() ; Sw_WriteDouble( w, 10, 943.920153 ) ; Sw_WriteI16( w, 70, 42 )
   c := TxR_New( StrTran( Sw_Output( w ), Chr( 13 ), "" ) ) ; o := TxR_ReadPair( c )
   Chk( Dp_AsDouble( o ) == 943.920153 .AND. Dp_AsInt( TxR_ReadPair( c ) ) == 42, "[extra] texto: roundtrip escritor->lector" )
RETURN
