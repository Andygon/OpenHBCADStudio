/* Tests 1:1 de polyface_mesh.rs (17 #[test]) + [extra] */
#include "ocx.ch"
STATIC FUNCTION Nr( a, b ) ; RETURN Abs( a - b ) < 0.0000000001
PROCEDURE T_CodecPolyface()
   LOCAL m, idx, v, f, n, n2, a, bb, ix
   m := Epf_New() ; Chk( Epf_VertexCount( m ) == 0 .AND. Epf_FaceCount( m ) == 0 .AND. hb_bitAnd( m[ "flags" ], PF_POLYFACE_MESH ) != 0, "polyface: test_mesh_creation" )
   m := Epf_New() ; idx := Epf_AddVertexXyz( m, 1.0, 2.0, 3.0 ) ; v := Epf_Vertex( m, 1 )
   Chk( idx == 1 .AND. Epf_VertexCount( m ) == 1 .AND. v[ "location" ][ 1 ] == 1.0 .AND. v[ "location" ][ 2 ] == 2.0 .AND. v[ "location" ][ 3 ] == 3.0, "polyface: test_add_vertex" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.5, 1.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 )
   Chk( Epf_FaceCount( m ) == 1 .AND. Pff_IsTriangle( m[ "faces" ][ 1 ] ) .AND. Epf_TriangleCount( m ) == 1 .AND. Epf_QuadCount( m ) == 0, "polyface: test_add_triangle" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 1.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.0, 1.0, 0.0 ) ; Epf_AddQuad( m, 1, 2, 3, 4 )
   Chk( Epf_FaceCount( m ) == 1 .AND. Pff_IsQuad( m[ "faces" ][ 1 ] ) .AND. Epf_QuadCount( m ) == 1, "polyface: test_add_quad" )
   f := Pff_Triangle( 1, 2, 3 ) ; a := Pff_VertexIndices( f ) ; f := Pff_Quad( 1, 2, 3, 4 ) ; n := Pff_VertexIndices( f )
   Chk( Len( a ) == 3 .AND. a[ 1 ] == 1 .AND. a[ 3 ] == 3 .AND. Len( n ) == 4 .AND. n[ 4 ] == 4, "polyface: test_face_vertex_indices" )
   f := Pff_TriangleWithVisibility( 1, 2, 3, .T., .F., .T. ) ; a := Pff_VertexIndices( f )
   Chk( Pff_IsEdge1Invisible( f ) .AND. ! Pff_IsEdge2Invisible( f ) .AND. Pff_IsEdge3Invisible( f ) .AND. a[ 1 ] == 1 .AND. a[ 2 ] == 2 .AND. a[ 3 ] == 3 .AND. Len( a ) == 3, "polyface: test_invisible_edges" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.5, 1.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 ) ; v := Epf_FaceVertices( m, m[ "faces" ][ 1 ] )
   Chk( Len( v ) == 3 .AND. Vc3_Eq( v[ 1 ], Vc3_Zero() ), "polyface: test_face_vertices" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.0, 1.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 ) ; n := Epf_FaceNormal( m, m[ "faces" ][ 1 ] )
   Chk( Nr( n[ 3 ], 1.0 ) .OR. Nr( n[ 3 ], -1.0 ), "polyface: test_face_normal" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 2.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.0, 2.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 )
   Chk( Nr( Epf_FaceArea( m, m[ "faces" ][ 1 ] ), 2.0 ), "polyface: test_face_area" )
   m := Epf_CreateBox( Vc3_Zero(), Vc3_New( 1.0, 1.0, 1.0 ) ) ; Chk( Epf_VertexCount( m ) == 8 .AND. Epf_FaceCount( m ) == 6 .AND. Epf_Validate( m ), "polyface: test_create_box" )
   m := Epf_CreatePyramid( Vc3_Zero(), 2.0, 1.0 ) ; Chk( Epf_VertexCount( m ) == 5 .AND. Epf_FaceCount( m ) == 5 .AND. Epf_Validate( m ), "polyface: test_create_pyramid" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 1.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.0, 1.0, 0.0 ) ; Epf_AddQuad( m, 1, 2, 3, 4 )
   ix := Epf_QuadCount( m ) ; Epf_Triangulate( m ) ; Chk( ix == 1 .AND. Epf_TriangleCount( m ) == 2 .AND. Epf_QuadCount( m ) == 0, "polyface: test_triangulate" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.5, 1.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 ) ; ix := Epf_Validate( m ) ; Epf_AddTriangle( m, 1, 2, 10 )
   Chk( ix .AND. ! Epf_Validate( m ), "polyface: test_validate" )
   m := Epf_CreateBox( Vc3_Zero(), Vc3_New( 2.0, 3.0, 4.0 ) ) ; bb := Epf_BoundingBox( m ) ; Chk( Vc3_Eq( bb[ 1 ], Vc3_Zero() ) .AND. Vc3_Eq( bb[ 2 ], Vc3_New( 2.0, 3.0, 4.0 ) ), "polyface: test_bounding_box" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Ent_Translate( m, Vc3_New( 10.0, 20.0, 30.0 ) )
   Chk( Epf_Vertex( m, 1 )[ "location" ][ 1 ] == 10.0 .AND. Epf_Vertex( m, 2 )[ "location" ][ 1 ] == 11.0, "polyface: test_translate" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.5, 1.0, 0.0 ) ; Epf_AddTriangle( m, 1, 2, 3 )
   n := Epf_FaceNormal( m, m[ "faces" ][ 1 ] ) ; Epf_FlipNormals( m ) ; n2 := Epf_FaceNormal( m, m[ "faces" ][ 1 ] ) ; Chk( Abs( n[ 3 ] + n2[ 3 ] ) < 0.0000000001, "polyface: test_flip_normals" )
   m := Epf_New() ; Epf_AddVertexXyz( m, 0.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 0.0, 0.0 ) ; Epf_AddVertexXyz( m, 1.0, 1.0, 0.0 ) ; Epf_AddVertexXyz( m, 0.0, 1.0, 0.0 ) ; Epf_AddQuad( m, 1, 2, 3, 4 ) ; Chk( Nr( Epf_TotalArea( m ), 1.0 ), "polyface: test_total_area" )
   f := Pff_Triangle( 1, 2, 3 ) ; Pff_Reverse( f ) ; Chk( f[ "index1" ] == 3 .AND. f[ "index2" ] == 2 .AND. f[ "index3" ] == 1, "polyface: test_face_reverse" )
   m := Epf_New() ; Chk( Ent_EntityType( m ) == "POLYLINE" .AND. Epf_Vertex( m, 0 ) == NIL .AND. Epf_Vertex( m, 1 ) == NIL .AND. Vc3_Eq( Ent_BoundingBox( m )[ 2 ], Vc3_Zero() ), "polyface: [extra] vacio, indices fuera de rango y entity_type" )
   m := Epf_CreateBox( Vc3_Zero(), Vc3_New( 1.0, 1.0, 1.0 ) ) ; f := hb_HClone( m[ "faces" ][ 1 ] ) ; Ent_ApplyMirror( m, Tf_FromMirrorX() )
   Chk( m[ "faces" ][ 1 ][ "index1" ] == f[ "index4" ] .AND. m[ "faces" ][ 1 ][ "index2" ] == f[ "index3" ] .AND. Epf_Vertex( m, 2 )[ "location" ][ 1 ] == -1.0, "polyface: [extra] espejo invierte las caras" )
   f := Pff_Quad( 1, 2, 3, 4 ) ; Pff_SetEdgeVisibility( f, 1, .F. ) ; Pff_SetEdgeVisibility( f, 7, .F. ) ; ix := Pff_IsEdge2Invisible( f ) ; Pff_SetEdgeVisibility( f, 1, .T. )
   Chk( ix .AND. f[ "index2" ] == 2 .AND. Pff_VertexCount( f ) == 4 .AND. Pff_VertexCount( Pff_Default() ) == 3, "polyface: [extra] set_edge_visibility y vertex_count" )
RETURN
